# Copy to .env and fill in. .env is git-ignored — never commit real keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Twilio WhatsApp sandbox: console.twilio.com → Messaging → Try it out → Send a WhatsApp message
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Your public webhook URL exactly as entered in Twilio (e.g. https://xxxx.ngrok-free.app/whatsapp)
PUBLIC_WEBHOOK_URL=
# Receptionist's WhatsApp (must also join the sandbox), e.g. whatsapp:+965XXXXXXXX
STAFF_WHATSAPP=
# Any long random string; protects /admin endpoints
ADMIN_TOKEN=

# CLINIC_DB=data/clinic.db
# CLINIC_ANSWER_THRESHOLD=0.10
