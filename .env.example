# Copy to .env and fill in. .env is git-ignored — never commit real keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Option A — Meta WhatsApp Cloud API (free test number): developers.facebook.com → your app → WhatsApp → API Setup
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
# App settings → Basic → App secret
META_APP_SECRET=
# Any string you choose; type the same one in WhatsApp → Configuration → Webhook
META_VERIFY_TOKEN=

# Option B — Twilio WhatsApp sandbox: console.twilio.com → Messaging → Try it out → Send a WhatsApp message
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Your public webhook URL exactly as entered in Twilio (e.g. https://xxxx.ngrok-free.app/whatsapp)
PUBLIC_WEBHOOK_URL=

# Receptionist's WhatsApp, any format (e.g. +201xxxxxxxxx). Gets handoff alerts; sends "done <id>" to release.
STAFF_WHATSAPP=
# Any long random string; protects /admin endpoints
ADMIN_TOKEN=

# CLINIC_DB=data/clinic.db
# CLINIC_ANSWER_THRESHOLD=0.10
